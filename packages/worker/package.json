{
  "name": "@kuroflare/worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "hayatosc",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch",
    "dev:local": "wrangler dev --local --ip 127.0.0.1 --port 8787 --persist-to /tmp/kuroflare-worker-miniflare-state --var DEVICE_TOKEN_SECRET:e2e-device-token-secret --var ADMIN_TOKEN_SECRET:e2e-admin-secret"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.3.0",
    "@kuroflare/core": "workspace:*",
    "hono": "^4.12.27",
    "kysely": "^0.29.2",
    "valibot": "^1.4.1",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.20",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "^22.15.30",
    "typescript": "^7.0.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
