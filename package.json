{
  "name": "kuroflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:compat": "pnpm -r typecheck:compat",
    "lint": "oxlint src/main && pnpm -r exec oxlint .",
    "lint:types": "oxlint --type-aware src/main && pnpm -r exec oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.15.30",
    "@typescript/native-preview": "7.0.0-dev.20260615.1",
    "obsidian": "1.13.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsdown": "^0.22.2",
    "valibot": "^1.4.1",
    "vitest": "^4.1.9",
    "yjs": "^13.6.27"
  },
  "packageManager": "pnpm@11.2.0"
}
