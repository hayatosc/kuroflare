{
  "name": "kuroflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm --filter @kuroflare/core build && pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "lint": "pnpm -r exec oxlint .",
    "lint:types": "pnpm -r exec oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "version:sync": "node --experimental-strip-types scripts/version.ts sync",
    "version:check": "node --experimental-strip-types scripts/version.ts check",
    "release:plugin:validate": "node --experimental-strip-types scripts/release/plugin.ts validate",
    "release:plugin:stage": "node --experimental-strip-types scripts/release/plugin.ts stage",
    "release:plugin:checksum": "node --experimental-strip-types scripts/release/plugin.ts checksum",
    "release:worker:stage": "node --experimental-strip-types scripts/release/worker.ts stage",
    "release:worker:generate": "node --experimental-strip-types scripts/release/worker.ts generate",
    "release:worker:checksum": "node --experimental-strip-types scripts/release/worker.ts checksum",
    "release:worker:validate-pointers": "node --experimental-strip-types scripts/release/worker.ts validate-pointers",
    "release:worker:pause": "node --experimental-strip-types scripts/release/worker.ts pointer-pause",
    "release:worker:promote": "node --experimental-strip-types scripts/release/worker.ts pointer-promote",
    "release:worker:rollout": "node --experimental-strip-types scripts/release/worker.ts pointer-rollout",
    "release:worker:block": "node --experimental-strip-types scripts/release/worker.ts pointer-block",
    "release:worker:unblock": "node --experimental-strip-types scripts/release/worker.ts pointer-unblock",
    "test:deploy-template": "node --test deploy/cloudflare/test/*.test.mjs",
    "test:release": "node --experimental-strip-types --test scripts/release/*.test.ts"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.15.30",
    "obsidian": "1.13.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.0",
    "valibot": "^1.4.1",
    "vitest": "^4.1.9",
    "yjs": "^13.6.27"
  },
  "packageManager": "pnpm@11.2.0"
}
